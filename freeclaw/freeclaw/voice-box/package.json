{
  "name": "voice-box",
  "private": true,
  "version": "2.0.1",
  "description": "Voice Flow — anonymous school feedback platform for students and administrators.",
  "author": "Voice Flow",
  "license": "UNLICENSED",
  "homepage": "https://voice-box-psi.vercel.app",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run --config vitest.config.api.ts",
    "env:doctor": "node scripts/env-doctor.mjs",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "desktop:start": "electron electron/main.cjs",
    "desktop:build": "VB_NATIVE_ELECTRON=1 npm run build && electron-builder --config electron-builder.yml --win --publish never",
    "mobile:sync": "cap sync",
    "mobile:open:android": "cap open android",
    "loadtest": "node scripts/loadtest.mjs",
    "audit:workers": "node scripts/audit-workers.mjs",
    "audit:capabilities": "node scripts/audit-capabilities.mjs",
    "audit:security": "npm audit --omit=dev && node scripts/security-scan.mjs",
    "example:ai-gateway": "tsx examples/ai-gateway/index.ts"
  },
  "dependencies": {
    "@capacitor/preferences": "^7.0.4",
    "@emailjs/browser": "^4.4.1",
    "@sentry/node": "~10.69.0",
    "@sentry/react": "^10.69.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@supabase/supabase-js": "^2.99.1",
    "ai": "^7.0.122",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "sharp": "^0.34.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
