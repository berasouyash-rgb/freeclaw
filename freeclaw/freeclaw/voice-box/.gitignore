# Mechanical audit output (regenerated by tests/e2e/audit.spec.ts)
tests/e2e/.audit-report.json
tests/e2e/.audit-report.json.*.tmp

# Native shells (regenerated in CI — never commit)
android/
ios/
electron/dist/
electron/icon.png
release/
resources/
*.apk
*.aab

# ...except the Android build the release pipeline publishes. It is what the
# download page serves and /api/version advertises, so it has to travel with
# the deployment. The Windows installer (~90 MB) travels with it too — it is
# what the Download page serves for everyone who cannot build it themselves.
!public/downloads/
!public/downloads/*.apk
!public/downloads/*.exe
!public/downloads/*.blockmap
